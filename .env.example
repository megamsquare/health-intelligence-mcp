# ── Remote database (Neon — production and manual local setup) ────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Local Docker Compose database ────────────────────────────────────────────
# docker-compose.yml sets DATABASE_URL automatically for the app container.
# Uncomment this only when running the app locally *without* Docker:
# DATABASE_URL=postgresql://healthintel:healthintel@localhost:5432/healthintel?sslmode=disable

# ── API keys ──────────────────────────────────────────────────────────────────
PUBMED_API_KEY=your_pubmed_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENFDA_API_KEY=your_openfda_api_key_here

PORT=3000

# ── Cache ─────────────────────────────────────────────────────────────────────
USE_REDIS=false
